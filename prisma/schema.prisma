generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id        String   @id @default(cuid())
  nombre    String
  telefono  String?  @unique
  interes   String
  createdAt DateTime @default(now())

  citas     Cita[]

  @@map("leads")
}

model Cita {
  id        String   @id @default(cuid())
  leadId    String
  fechaHora DateTime @unique
  motivo    String
  createdAt DateTime @default(now())

  lead      Lead     @relation(fields: [leadId], references: [id])

  @@index([fechaHora])
  @@map("citas")
}

model Conversation {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())

  messages  Message[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           Role
  content        String
  toolName       String?
  toolArgs       Json?
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@map("messages")
}

enum Role {
  user
  assistant
  tool
  system
}
