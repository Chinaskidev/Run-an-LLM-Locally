# --- Postgres (consumido por podman-compose y por Prisma) ---
POSTGRES_USER=agente
POSTGRES_PASSWORD=cambiame_en_local
POSTGRES_DB=agente_local

# DATABASE_URL debe coincidir con las credenciales de arriba.
# host=localhost porque el puerto 5432 del contenedor está expuesto a localhost.
DATABASE_URL="postgresql://agente:cambiame_en_local@localhost:5432/agente_local?schema=public"

# --- LLM local (Ollama) ---
OLLAMA_HOST=http://127.0.0.1:11434
# Swappable sin tocar código: ministral-3:8b | qwen2.5:7b
MODEL=ministral-3:8b

# --- Logging ---
# debug | info | warn | error
LOG_LEVEL=info
