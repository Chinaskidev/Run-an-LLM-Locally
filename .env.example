# --- Postgres (consumido por podman-compose y por Prisma) ---
POSTGRES_USER=agente
POSTGRES_PASSWORD=cambiame_en_local
POSTGRES_DB=agente_local

# DATABASE_URL debe coincidir con las credenciales de arriba.
# host=localhost porque el puerto 5432 del contenedor está expuesto a localhost.
DATABASE_URL="postgresql://agente:cambiame_en_local@localhost:5432/agente_local?schema=public"

# --- Proveedor del LLM ---
# ollama (default: todo local) | openrouter (nube opt-in, para benchmarking)
LLM_PROVIDER=ollama

# --- LLM local (Ollama) ---
OLLAMA_HOST=http://127.0.0.1:11434
# Swappable sin tocar código.
# Con ollama: qwen3.5:4b | ministral-3:8b
# Con openrouter: qwen/qwen3.5-flash-02-23 | qwen/qwen3-next-80b-a3b-instruct:free
MODEL=qwen3.5:4b

# --- OpenRouter (solo si LLM_PROVIDER=openrouter) ---
# La key REAL va en .env (gitignoreado), NUNCA en este archivo (es un template público).
# Se crea en https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-...

# --- Logging ---
# debug | info | warn | error
LOG_LEVEL=info
